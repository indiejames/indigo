# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib
/indigo
/jumpy
/indigo-spell
/indigo-git

# Common binary output directories
bin/
dist/
out/

.DS_Store

# Test binaries and coverage reports
*.test
*.out
*.coverprofile
profile.cov

# Go workspace files (should not be shared)
go.work
go.work.sum

# Local environment variables
.env
.env.local

examples

# Plugin built binaries (source is tracked, binaries are not)
!plugins/*/jumpy-*
!plugins/*/indigo-spell-*
!plugins/*/indigo-git-*

# Dependency directories (Optional)
# Only uncomment if you explicitly want to vendor dependencies
# vendor/

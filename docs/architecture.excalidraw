    {"id":"code_b","type":"text","x":58,"y":1052,"width":440,"height":162,"text":"type Op struct {\n  ClientID, Version uint64\n  Type   OpType  // insert | delete\n  InsertLine, InsertCol int\n  InsertText string\n  FromLine, FromCol, ToLine, ToCol int\n  ExpectText string // set by agents\n}","originalText":"type Op struct {\n  ClientID, Version uint64\n  Type   OpType  // insert | delete\n  InsertLine, InsertCol int\n  InsertText string\n  FromLine, FromCol, ToLine, ToCol int\n  ExpectText string // set by agents\n}","fontSize":15,"fontFamily":3,"textAlign":"left","verticalAlign":"top","strokeColor":"#22c55e","backgroundColor":"transparent","roughness":0,"opacity":100,"lineHeight":1.25,"seed":500012},


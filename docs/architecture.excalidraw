    {"id":"warn_t","type":"text","x":620,"y":1172,"width":1200,"height":46,"text":"Fallback: a wholesale swap (format-on-save, reload, SaveAs) bumps generation. An op carrying the old\ngeneration is rejected and the client resyncs from getBufferSnapshot — never applied to the wrong text.","originalText":"Fallback: a wholesale swap (format-on-save, reload, SaveAs) bumps generation. An op carrying the old\ngeneration is rejected and the client resyncs from getBufferSnapshot — never applied to the wrong text.","fontSize":15,"fontFamily":3,"textAlign":"left","verticalAlign":"top","strokeColor":"#991b1b","backgroundColor":"transparent","roughness":0,"opacity":100,"lineHeight":1.25,"seed":500201}

    {"id":"tl_t1","type":"text","x":605,"y":1060,"width":225,"height":72,"text":"1  window A\ntypes \"x\": applied\nlocally, held in\npending","originalText":"1  window A\ntypes \"x\": applied\nlocally, held in\npending","fontSize":14,"fontFamily":3,"textAlign":"left","verticalAlign":"top","strokeColor":"#374151","backgroundColor":"transparent","roughness":0,"opacity":100,"lineHeight":1.25,"seed":500111},
    {"id":"tl_t2","type":"text","x":845,"y":1060,"width":225,"height":72,"text":"2  applyOp(op,\nbaseVersion=41):\nserver drops what\nA already saw","originalText":"2  applyOp(op,\nbaseVersion=41):\nserver drops what\nA already saw","fontSize":14,"fontFamily":3,"textAlign":"left","verticalAlign":"top","strokeColor":"#374151","backgroundColor":"transparent","roughness":0,"opacity":100,"lineHeight":1.25,"seed":500112},
    {"id":"tl_t3","type":"text","x":1085,"y":1060,"width":225,"height":72,"text":"3  Transform(op,\nB's v42 op):\nrebase past what\nA hasn't seen","originalText":"3  Transform(op,\nB's v42 op):\nrebase past what\nA hasn't seen","fontSize":14,"fontFamily":3,"textAlign":"left","verticalAlign":"top","strokeColor":"#b45309","backgroundColor":"transparent","roughness":0,"opacity":100,"lineHeight":1.25,"seed":500113},
    {"id":"tl_t4","type":"text","x":1325,"y":1060,"width":225,"height":72,"text":"4  apply → v43,\nappend to B's\noutgoing queue","originalText":"4  apply → v43,\nappend to B's\noutgoing queue","fontSize":14,"fontFamily":3,"textAlign":"left","verticalAlign":"top","strokeColor":"#374151","backgroundColor":"transparent","roughness":0,"opacity":100,"lineHeight":1.25,"seed":500114},
    {"id":"tl_t5","type":"text","x":1565,"y":1060,"width":225,"height":72,"text":"5  B polls\ngetUpdates,\nrebases past own\npending, applies","originalText":"5  B polls\ngetUpdates,\nrebases past own\npending, applies","fontSize":14,"fontFamily":3,"textAlign":"left","verticalAlign":"top","strokeColor":"#374151","backgroundColor":"transparent","roughness":0,"opacity":100,"lineHeight":1.25,"seed":500115},

    {"id":"e_head","type":"text","x":40,"y":950,"width":900,"height":25,"text":"ONE CONCURRENT EDIT, END TO END","originalText":"ONE CONCURRENT EDIT, END TO END","fontSize":20,"fontFamily":3,"textAlign":"left","verticalAlign":"top","strokeColor":"#1e40af","backgroundColor":"transparent","roughness":0,"opacity":100,"lineHeight":1.25,"seed":500001},
    {"id":"e_sub","type":"text","x":40,"y":978,"width":1100,"height":18,"text":"every edit — keystroke, undo, plugin, agent — is a document.Op that both client and server apply","originalText":"every edit — keystroke, undo, plugin, agent — is a document.Op that both client and server apply","fontSize":14,"fontFamily":3,"textAlign":"left","verticalAlign":"top","strokeColor":"#3b82f6","backgroundColor":"transparent","roughness":0,"opacity":100,"lineHeight":1.25,"seed":500002},

